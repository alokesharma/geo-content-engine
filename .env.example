# Copy this file to .env and add your own keys.
# Load before a run:  set -a; source .env; set +a

# SerpAPI (https://serpapi.com) - used for SERP, PAA, AI Mode, Forums, News, Videos. Paid.
SERPAPI_KEY=

# Ahrefs API v3 (https://ahrefs.com) - used for related terms + question terms. Paid.
# Optional if you call Ahrefs via connected MCP tools instead of the REST API.
AHREFS_API_TOKEN=

# The site you write for (used for the internal-link and site-context steps)
SITE_DOMAIN=example.com

# Your brand name (used in voice and metadata rules)
BRAND_NAME=Acme

# Optional: only for the Google Docs delivery add-on (see optional/google-docs-delivery/)
# GOOGLE_CREDENTIALS_PATH=~/.config/geo-content-engine/credentials.json
